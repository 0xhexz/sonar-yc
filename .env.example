# ===========================================================================
# YC Radar — environment configuration
# Copy to `.env` and fill in. Every value below is optional except the ones
# you actually use. Missing credentials are handled gracefully (dry-run/mock).
# ===========================================================================

# ---- Monitoring cadence (per-source; edit to taste) -----------------------
# YC directory poll (hours). Each scan = 1 headless render (~5s) — free.
YC_INTERVAL_HOURS=8
# Speedrun (a16z) poll (hours). Clean REST API — free.
SPEEDRUN_INTERVAL_HOURS=8
# X poll (minutes). TwtAPI free tier: 300 calls/mo — 30min = ~1440/mo... see note.
# NOTE: 30min with 7 keywords uses ~210 searches/mo (fits free tier).
X_INTERVAL_MINUTES=30
# LinkedIn poll (hours). Apify cost: ~$0.12/scan at 15 posts x 5 keywords.
# 24h = ~$3.50/mo (fits free $5). 12h = ~$7 (exceeds free!).
LINKEDIN_INTERVAL_HOURS=24
LINKEDIN_MAX_POSTS=15
# Run one full scan immediately on startup (nice for testing).
RUN_ON_START=true
# Comma list of enabled sources.
SOURCES_ENABLED=yc,speedrun,x,linkedin
# Optional comma list of YC batches to poll (blank = detect current batch).
YC_BATCHES=

# ---- X (Twitter) third-party provider — CHOOSE ONE ------------------------
# Our adapter auto-detects the provider from the base URL. Supported:
#   A) TwtAPI        https://www.twtapi.com/api-proxy/api/v1/twitter/Search
#                      $15/mo = 50k CALLS (per-call billing; 1 call = 30-40 tweets)
#                      Best for 30-min cadence. (ChirpSieve's key works here too.)
#   B) twitterapi.io https://api.twitterapi.io
#                      $0.15/1K tweets (per-tweet billing). Best for 3-hourly.
#                      Docs: GET /twitter/tweet/advanced_search?query=&queryType=Latest
#   C) Sorsa         https://api.sorsa.io
#                      $49/mo floor (per-request, ~20 tweets/req). Rarely worth it.
# Set base URL + key of the one you pick:
X_PROVIDER_BASE_URL=https://www.twtapi.com/api-proxy/api/v1/twitter/Search
X_PROVIDER_API_KEY=
# Provider search path (defaults to twitterapi.io's advanced search path).
X_PROVIDER_SEARCH_PATH=/twitter/tweet/advanced_search
# Keyword set for X search (comma-separated; quote phrases).
X_KEYWORDS="Y Combinator","got into YC","YC S26","backed by Y Combinator","accepted to YC","YC batch","a16z speedrun"
# Restrict X results to a language (ISO code).
X_LANG=en

# ---- LinkedIn third-party provider ---------------------------------------
# Base URL + API key of a LinkedIn data provider.
LINKEDIN_PROVIDER_BASE_URL=
LINKEDIN_PROVIDER_API_KEY=
LINKEDIN_PROVIDER_SEARCH_PATH=/api/posts/search
LINKEDIN_KEYWORDS="got into YC","Y Combinator","YC batch","accepted to YC","a16z speedrun"

# ---- Slack ----------------------------------------------------------------
# Bot token (xoxb-...) — recommended. Requires chat:write scope.
SLACK_BOT_TOKEN=
# OR an Incoming Webhook URL (simplest). If both set, the bot token wins.
SLACK_WEBHOOK_URL=
# Channel to post alerts to, OR set a user to DM.
SLACK_CHANNEL=#yc-radar
# Set this to a Slack user id/email to DM instead of posting to a channel.
SLACK_DM_USER=

# ---- Pond ----------------------------------------------------------------
# Access Key generated on your Pond agent publishing page.
POND_ACCESS_KEY=

# ---- Data / misc ----------------------------------------------------------
DATA_DIR=data
# Timezone used for alert timestamps.
TIMEZONE=America/Los_Angeles
HTTP_TIMEOUT=30
